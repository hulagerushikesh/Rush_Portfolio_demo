# ── Firebase Admin (server-side) ──────────────────────────────────────────────
# Firebase Console -> Project Settings -> Service accounts -> Generate new key.
# FIREBASE_PRIVATE_KEY keeps its literal \n escapes; the app unescapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ── Firebase client (browser) — admin sign-in only ────────────────────────────
# Firebase Console -> Project Settings -> General -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Comma-separated allowlist of emails permitted to reach /admin.
ADMIN_EMAILS=hulagerushikesh@gmail.com

# Optional: SMTP creds for a best-effort email notification when the contact
# form is submitted. If unset, messages are still saved to Firestore.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_EMAIL=hulagerushikesh@gmail.com
