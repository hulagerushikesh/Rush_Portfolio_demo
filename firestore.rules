rules_version = '2';

// The portfolio never touches Firestore from the browser — all reads and writes
// go through the Next.js server using the Admin SDK, which bypasses these rules.
// Denying everything here means a leaked client API key grants no data access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
