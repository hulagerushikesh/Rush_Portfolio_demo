rules_version = '2';

// Uploads happen server-side via the Admin SDK, which bypasses these rules.
// Uploaded objects are made individually public so <img> tags can read them
// over the public storage.googleapis.com URL without going through these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
